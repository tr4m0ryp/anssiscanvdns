{
  "hosts": {
    "canvas.uva.nl": {
      "inject": [
        "shim/storage.js",
        "canvas/config.js",
        "canvas/hidden_courses.js",
        "canvas/store.js",
        "canvas/css.js",
        "canvas/api.js",
        "canvas/marks/policy.js",
        "canvas/marks/css.js",
        "canvas/marks/grades.js",
        "canvas/marks/pages.js",
        "canvas/marks/index.js",
        "canvas/home.js",
        "canvas/index_page.js",
        "canvas/topic.js",
        "canvas/discussions.js",
        "canvas/main.js"
      ]
    },
    "ans.uva.nl": {
      "inject": [
        "shim/storage.js",
        "ans/config.js",
        "ans/items.js",
        "ans/password.js",
        "ans/main.js"
      ]
    }
  },
  "rules": [
    {
      "note": "Statistisch Redeneren is hidden: its course pages bounce to the dashboard before they load",
      "action": "redirect",
      "host": "ans.uva.nl",
      "path": "^/courses/695168(/|$|\\?)",
      "to": "/"
    },
    {
      "note": "Statistisch Redeneren + Lineaire algebra NS hidden: course pages bounce to the dashboard",
      "action": "redirect",
      "host": "canvas.uva.nl",
      "path": "^/courses/(59995|59697)(/|$|\\?|#)",
      "to": "/"
    },
    {
      "note": "Hidden courses: their own API endpoints answer 404",
      "action": "block",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/courses/(59995|59697)(/|$|\\?)",
      "status": 404
    },
    {
      "note": "Hidden courses: dropped from every API list (dashboard, planner, calendar, inbox, GraphQL)",
      "action": "drop",
      "host": "canvas.uva.nl",
      "path": "^/api/",
      "match": "(course_|/courses/)(59995|59697)\\b|\"course_?[iI]d\":\\s*\"?(59995|59697)\\b|5062STRE6Y|5092LAVN6Y|Statistisch Redeneren|Lineaire algebra voor Natuur"
    },
    {
      "note": "Example, switched off: block an endpoint outright",
      "off": true,
      "action": "block",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/courses/59300/analytics",
      "status": 404
    },
    {
      "note": "Example, switched off: rewrite text inside a JSON response",
      "off": true,
      "action": "replace",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/courses/59300/assignments",
      "type": "json",
      "find": "\"score\":\\s*[0-9.]+",
      "with": "\"score\":null"
    }
  ]
}
