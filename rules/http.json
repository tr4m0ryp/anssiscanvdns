{
  "hosts": {
    "canvas.uva.nl": {
      "inject": [
        "shim/storage.js",
        "canvas/config.js",
        "canvas/hidden_courses.js",
        "canvas/store.js",
        "canvas/css.js",
        "canvas/api.js",
        "canvas/marks/policy.js",
        "canvas/marks/css.js",
        "canvas/marks/grades.js",
        "canvas/marks/pages.js",
        "canvas/marks/index.js",
        "canvas/topic.js",
        "canvas/ann_index.js",
        "canvas/discussions.js",
        "canvas/main.js"
      ]
    },
    "ans.uva.nl": {
      "inject": [
        "shim/storage.js",
        "ans/config.js",
        "ans/items.js",
        "ans/password.js",
        "ans/main.js"
      ]
    },
    "github.com": {
      "inject": []
    }
  },
  "rules": [
    {
      "note": "Statistisch Redeneren is hidden: its ANS course pages (results included) bounce to the dashboard before they load",
      "action": "redirect",
      "host": "ans.uva.nl",
      "path": "^(/universities/\\d+)?/courses/695168(/|$|\\?|#)",
      "to": "/"
    },
    {
      "note": "Statistisch Redeneren + Lineaire algebra NS hidden: course pages bounce to the dashboard",
      "action": "redirect",
      "host": "canvas.uva.nl",
      "path": "^/courses/(59995|59697)(/|$|\\?|#)",
      "to": "/"
    },
    {
      "note": "Hidden courses: their own API endpoints answer 404",
      "action": "block",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/courses/(59995|59697)(/|$|\\?)",
      "status": 404
    },
    {
      "note": "Hidden courses: dropped from every API list (dashboard, planner, calendar, inbox, GraphQL)",
      "action": "drop",
      "host": "canvas.uva.nl",
      "path": "^/api/",
      "match": "(course_|/courses/)(59995|59697)\\b|\"course_?[iI]d\":\\s*\"?(59995|59697)\\b|5062STRE6Y|5092LAVN6Y|Statistisch Redeneren|Lineaire algebra voor Natuur"
    },
    {
      "note": "Governed courses (VenV-1, WDD-1): the Discussions section, pinned discussions included, bounces to the course home at the proxy, before any script runs",
      "action": "redirect",
      "host": "canvas.uva.nl",
      "path": "^/courses/(59331|59300)/discussion_topics/?(\\?|#|$)",
      "to": "/"
    },
    {
      "note": "Governed courses: plain discussions (pinned ones included) dropped from their topic lists; the scripts' own id lookups (cvh=1) pass through",
      "action": "drop",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/courses/(59331|59300)/discussion_topics(?![^#]*cvh=1)",
      "match": "\"is_announcement\":\\s*false"
    },
    {
      "note": "Announcements index bounces to the dashboard in every course except WDD-1 (59300), whose index shows only its allowed announcements",
      "action": "redirect",
      "host": "canvas.uva.nl",
      "path": "^/courses/(?!59300(?:/|$|\\?|#))\\d+/announcements(/|$|\\?|#)",
      "to": "/"
    },
    {
      "note": "Announcements API: every announcement dropped except WDD-1's allowed ones (1177553, 1173491, 1188382)",
      "action": "drop",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/announcements(/|$|\\?)",
      "match": "^(?![\\s\\S]*(?:discussion_topics/|\"id\":\\s*\"?)(?:1177553|1173491|1188382)\\b)"
    },
    {
      "note": "Announcements, every course: dropped from every API list (To-do, planner, activity stream, topic lists, GraphQL), except WDD-1's allowed ones (1177553, 1173491, 1188382)",
      "action": "drop",
      "host": "canvas.uva.nl",
      "path": "^/api/",
      "match": "^(?![\\s\\S]*(?:discussion_topics/|\"(?:plannable_)?id\":\\s*\"?|\"_id\":\\s*\")(?:1177553|1173491|1188382)\\b)[\\s\\S]*?(?:\"plannable_type\":\\s*\"announcement\"|\"is_announcement\":\\s*true|\"isAnnouncement\":\\s*true|\"type\":\\s*\"Announcement\")"
    },
    {
      "note": "github.com/tr4m0ryp profile page blocked (self). Only the exact profile path, not /tr4m0ryp/<repo>, so repos and the sync keep working.",
      "action": "redirect",
      "host": "github.com",
      "path": "^/tr4m0ryp(\\?.*)?/?$",
      "to": "/"
    },
    {
      "note": "X self-block: tr4m0ryp profile and tweet pages go to X's not-found page",
      "action": "redirect",
      "host": "x.com",
      "path": "(?i)^/tr4m0ryp(/|\\?|#|$)",
      "to": "/i/notfound_404_page",
      "off": true
    },
    {
      "note": "X self-block: profile lookups for tr4m0ryp answer as a nonexistent account",
      "action": "block",
      "host": "x.com",
      "path": "^/(i/api|graphql|1\\.1|2)/",
      "request": "(?i)\"screen_?name\"\\s*:\\s*\"tr4m0ryp\"|screen_name=tr4m0ryp\\b",
      "status": 200,
      "body": "{\"data\":{}}",
      "off": true
    },
    {
      "note": "X self-block: tweets, replies, mentions and user rows of tr4m0ryp dropped from timelines, search and lists",
      "action": "drop",
      "host": "x.com",
      "path": "^/",
      "match": "(?i)\"screen_name\"\\s*:\\s*\"tr4m0ryp\"",
      "within": [
        "entries",
        "moduleItems",
        "users",
        "items"
      ],
      "off": true
    },
    {
      "note": "Instagram self-block: tr4m0ryp profile and stories pages go to Instagram's not-found page",
      "action": "redirect",
      "host": "www.instagram.com",
      "path": "(?i)^/(stories/)?tr4m0ryp(/|\\?|#|$)",
      "to": "/p/notfound404/",
      "off": true
    },
    {
      "note": "Instagram self-block: profile info for tr4m0ryp answers as user not found",
      "action": "block",
      "host": "www.instagram.com",
      "path": "^/api/v1/users/web_profile_info/",
      "request": "(?i)username=tr4m0ryp\\b",
      "status": 404,
      "body": "{\"message\":\"User not found\",\"status\":\"fail\"}",
      "off": true
    },
    {
      "note": "Instagram self-block: GraphQL queries for tr4m0ryp answer with no user",
      "action": "block",
      "host": "www.instagram.com",
      "path": "^/(graphql/query|api/graphql)",
      "request": "(?i)\"username\"\\s*:\\s*\"tr4m0ryp\"",
      "status": 200,
      "body": "{\"data\":{\"user\":null},\"status\":\"ok\"}",
      "off": true
    },
    {
      "note": "Instagram self-block: posts, reels, stories and user rows of tr4m0ryp dropped from feeds and search",
      "action": "drop",
      "host": "www.instagram.com",
      "path": "^/",
      "match": "(?i)\"username\"\\s*:\\s*\"tr4m0ryp\"",
      "within": [
        "edges",
        "items",
        "users",
        "list",
        "results",
        "feed_items",
        "reels_media"
      ],
      "off": true
    },
    {
      "note": "Example, switched off: block an endpoint outright",
      "off": true,
      "action": "block",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/courses/59300/analytics",
      "status": 404
    },
    {
      "note": "Example, switched off: rewrite text inside a JSON response",
      "off": true,
      "action": "replace",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/courses/59300/assignments",
      "type": "json",
      "find": "\"score\":\\s*[0-9.]+",
      "with": "\"score\":null"
    }
  ]
}
