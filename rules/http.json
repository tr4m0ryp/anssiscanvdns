{
  "hosts": {
    "canvas.uva.nl": {
      "inject": [
        "shim/storage.js",
        "canvas/config.js",
        "canvas/hidden_courses.js",
        "canvas/store.js",
        "canvas/css.js",
        "canvas/api.js",
        "canvas/marks/policy.js",
        "canvas/marks/css.js",
        "canvas/marks/grades.js",
        "canvas/marks/pages.js",
        "canvas/marks/index.js",
        "canvas/topic.js",
        "canvas/ann_index.js",
        "canvas/discussions.js",
        "canvas/main.js"
      ]
    },
    "ans.uva.nl": {
      "inject": [
        "shim/storage.js",
        "ans/config.js",
        "ans/items.js",
        "ans/password.js",
        "ans/main.js"
      ]
    },
    "github.com": {
      "inject": []
    }
  },
  "rules": [
    {
      "note": "ANS results: every URL with 'result' in it bounces home, except results 25556935 and 25850035 (and their sub-pages). Static assets are left alone.",
      "action": "redirect",
      "host": "ans.uva.nl",
      "path": "^/(?!(?:assets|packs|vite)/)(?!results/(?:25556935|25850035)(?:[/?#]|$))[^#]*result",
      "to": "/"
    },
    {
      "note": "Statistisch Redeneren is hidden: its ANS course pages bounce to the dashboard before they load",
      "action": "redirect",
      "host": "ans.uva.nl",
      "path": "^/courses/695168(/|$|\\?)",
      "to": "/"
    },
    {
      "note": "Statistisch Redeneren + Lineaire algebra NS hidden: course pages bounce to the dashboard",
      "action": "redirect",
      "host": "canvas.uva.nl",
      "path": "^/courses/(59995|59697)(/|$|\\?|#)",
      "to": "/"
    },
    {
      "note": "Hidden courses: their own API endpoints answer 404",
      "action": "block",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/courses/(59995|59697)(/|$|\\?)",
      "status": 404
    },
    {
      "note": "Hidden courses: dropped from every API list (dashboard, planner, calendar, inbox, GraphQL)",
      "action": "drop",
      "host": "canvas.uva.nl",
      "path": "^/api/",
      "match": "(course_|/courses/)(59995|59697)\\b|\"course_?[iI]d\":\\s*\"?(59995|59697)\\b|5062STRE6Y|5092LAVN6Y|Statistisch Redeneren|Lineaire algebra voor Natuur"
    },
    {
      "note": "Announcements index bounces to the dashboard in every course except WDD-1 (59300), whose index shows only its allowed announcements",
      "action": "redirect",
      "host": "canvas.uva.nl",
      "path": "^/courses/(?!59300(?:/|$|\\?|#))\\d+/announcements(/|$|\\?|#)",
      "to": "/"
    },
    {
      "note": "Announcements API: every announcement dropped except WDD-1's allowed ones (1177553, 1173491, 1188382)",
      "action": "drop",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/announcements(/|$|\\?)",
      "match": "^(?![\\s\\S]*(?:discussion_topics/|\"id\":\\s*\"?)(?:1177553|1173491|1188382)\\b)"
    },
    {
      "note": "Announcements, every course: dropped from every API list (To-do, planner, activity stream, topic lists, GraphQL), except WDD-1's allowed ones (1177553, 1173491, 1188382)",
      "action": "drop",
      "host": "canvas.uva.nl",
      "path": "^/api/",
      "match": "^(?![\\s\\S]*(?:discussion_topics/|\"(?:plannable_)?id\":\\s*\"?|\"_id\":\\s*\")(?:1177553|1173491|1188382)\\b)[\\s\\S]*?(?:\"plannable_type\":\\s*\"announcement\"|\"is_announcement\":\\s*true|\"isAnnouncement\":\\s*true|\"type\":\\s*\"Announcement\")"
    },
    {
      "note": "github.com/tr4m0ryp profile page blocked (self). Only the exact profile path, not /tr4m0ryp/<repo>, so repos and the sync keep working.",
      "action": "redirect",
      "host": "github.com",
      "path": "^/tr4m0ryp(\\?.*)?/?$",
      "to": "/"
    },
    {
      "note": "Example, switched off: block an endpoint outright",
      "off": true,
      "action": "block",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/courses/59300/analytics",
      "status": 404
    },
    {
      "note": "Example, switched off: rewrite text inside a JSON response",
      "off": true,
      "action": "replace",
      "host": "canvas.uva.nl",
      "path": "^/api/v1/courses/59300/assignments",
      "type": "json",
      "find": "\"score\":\\s*[0-9.]+",
      "with": "\"score\":null"
    }
  ]
}
