[Unit]
Description=anssiscanvdns intercepting HTTPS proxy
After=wg-quick@wg0.service network-online.target
Requires=wg-quick@wg0.service

[Service]
User=@USER@
Environment=ANSSIS_ROOT=@ROOT@
ExecStart=@ROOT@/.venv/bin/mitmdump \
  --mode reverse:https://canvas.uva.nl@@WG_IP@:@PROXY_PORT@ \
  --set confdir=@HOME@/.config/anssiscanvdns/mitm \
  --set keep_host_header=true \
  --set connection_strategy=lazy \
  --set stream_large_bodies=5m \
  --set http3=false \
  --set flow_detail=0 \
  --set termlog_verbosity=warn \
  -s @ROOT@/proxy/addon.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
